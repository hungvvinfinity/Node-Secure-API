{
  "name": "node-secure-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' test/*.test.ts",
    "test:ci": "node scripts/require-test-redis.mjs && npm run test:coverage",
    "test:docker": "node scripts/test-compose.mjs",
    "canary:preflight": "node scripts/canary-preflight.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "security:sources": "node scripts/check-upstream.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:redis-restart": "tsx scripts/verify-redis-restart.ts"
  },
  "dependencies": {
    "@peculiar/x509": "3.1.0",
    "asn1js": "4.0.0",
    "cbor-x": "1.6.8",
    "pkijs": "4.0.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
