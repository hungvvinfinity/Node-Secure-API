<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Node-Secure-API Android Client"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bảo mật Hardware TEE/StrongBox &amp; Replay Guard strictly-increasing"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server URL (Host/LAN/Emulator):"
        android:textColor="#D0BCFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:background="#1E1E2E"
        android:padding="10dp"
        android:text="http://10.0.2.2:3000"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device ID: (chưa đăng ký)"
            android:textColor="#80D8FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tier: REQUIRE_REGISTRATION"
            android:textColor="#B9F6CA"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvHwLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware Level: Detecting..."
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSequence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seq: 0"
            android:textColor="#FF80AB"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Xin Challenge &amp; Đăng ký thiết bị (TEE)"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnReadTarot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Gọi API Tarot (Ký 4 Headers An Ninh)"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnTestReplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3. Thử Replay (401)"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTestTamper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4. Thử Tamper (401)"
                android:backgroundTint="#E65100"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestExpired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Thử Expired Timestamp (401)"
            android:backgroundTint="#C2185B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhật ký giao dịch / Log Console:"
        android:textColor="#D0BCFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Sẵn sàng] Bấm nút phía trên để bắt đầu thử nghiệm..."
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
