<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ Data Extraction Rules -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="security_demo_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="security_demo_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
