# Server configuration
PORT=3000
HOST=0.0.0.0
# Host interface binding for Docker Compose (0.0.0.0 for LAN/client access; use 127.0.0.1 for local/reverse-proxy only)
API_BIND_IP=0.0.0.0
NODE_ENV=production

# Redis configuration (Production requires Redis; no memory fallback)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=secure-api:
DATABASE_URL=postgres://postgres:securepass@127.0.0.1:5432/secure_api
CHALLENGE_HMAC_SECRET=replace-with-at-least-32-random-bytes-before-production

# Body size limits (bytes)
BODY_LIMIT_BYTES=1048576

# Android Attestation configuration (Phase 1)
ANDROID_ENABLED=true
EXPECTED_PACKAGE_NAME=com.astrology.tarot
# SHA256 app signing certificate digest (lowercase hex, 64 characters)
EXPECTED_SIGNER_DIGESTS=
MINIMUM_ANDROID_VERSION=1

# iOS App Attest configuration (Phase 2)
IOS_ENABLED=false
# IOS_APP_ID=TEAMID1234.com.astrology.tarot
# IOS_APP_ATTEST_ENV=production
# Optional strict policy for clients supplying Apple app properties:
# IOS_MINIMUM_BUNDLE_VERSION=1.0
# IOS_ALLOWED_VALIDATION_CATEGORIES=2,4
# IOS_REQUIRE_APP_PROPERTIES=true
